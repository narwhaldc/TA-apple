# secrets / tokens — NEVER commit. Bare names match at ANY depth (repo ROOT and
# tools/); **/ forms are explicit belt-and-suspenders so root-level creds can't leak.
.env
/.env
**/.env
# HEC targets (holds hec_token) — never commit (root and any subdir)
apple_targets.json
**/apple_targets.json
# optional Linux+iCloud (pyicloud) session cache + Apple app-password store
.pyicloud/
**/.pyicloud/
*apple_session*.json
apple_icloud_token.json

# personal health exports (PHI) — never commit
apple_samples/
tools/apple_samples/
*.HealthAutoExport*.json
HealthAutoExport*.json

# BELT-AND-SUSPENDERS: no data files anywhere under tools/ (the only tracked files
# there are apple_to_hec.py and the placeholder-only targets EXAMPLE below). Blocks
# any stray HAE export / sample / runtime-state file from leaking PHI or tokens into
# the repo via the tools/ vector.
tools/*.json
# EXCEPTION (deliberate): the targets TEMPLATE must be tracked so users can fetch it
# from GitHub — INSTALL.md step 3 and apple_to_hec.py's own error messages both tell
# you to copy it. It contains ONLY placeholders (YOUR-HEC-TOKEN / P001 / ~/hae_inbox),
# never real values; the filled-in apple_targets.json stays ignored by the rules above.
# Matches how TA-oura / TA-withings / TA-google track their own *_targets.example.json.
!tools/apple_targets.example.json
tools/*.csv
tools/*.ndjson
tools/*.jsonl
tools/*.xml
# also catch health/token files dropped at repo root
*.ndjson
*.jsonl
export*.json
metrics*.json

# runtime state (never commit)
apple_checkpoint.json
apple_dedup_store.json
apple_sync.lock
*.lock
*.tmp
*.log

# build artifacts / editor junk
*.spl
__pycache__/
*.pyc
*.swp
*.swo
.*.sw?
*~
.DS_Store
